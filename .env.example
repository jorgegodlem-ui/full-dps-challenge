# Copia este archivo como .env y pega tu key de developer.riotgames.com.
# .env está en .gitignore: no se sube al repo. En producción la key va como
# secret de GitHub Actions (Settings -> Secrets and variables -> Actions).
#
# Correr el sync local:  node --env-file=.env scripts/riot-sync.mjs

RIOT_API_KEY=RGAPI-pega-aca-tu-key

# Opcional: 1 calcula la racha real con match-v5 (~10 requests extra por jugador).
RIOT_STREAK=0
